{
  "name": "@xenial/oc-goal",
  "version": "0.2.0",
  "description": "Persistent thread goals for OpenCode: get/create/update goal tools, token & wall-clock budget accounting, automatic idle continuation, and a footer status indicator — a port of codex's goal feature.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./tui": "./dist/tui.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test test/*.test.mjs",
    "verify": "npm run build && npm test"
  },
  "dependencies": {
    "@opencode/plugin": "latest"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.5.17",
    "@opentui/solid": ">=0.5.17",
    "solid-js": ">=1.9.0"
  },
  "peerDependenciesMeta": {
    "@opentui/core": {
      "optional": true
    },
    "@opentui/solid": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@opentui/core": "^0.5.17",
    "@opentui/solid": "^0.5.17",
    "@types/node": "latest",
    "solid-js": "^1.9.17",
    "typescript": "latest"
  }
}
